// Mouse key top speed in counts per second (ZMK default 600). Matches QMK's
// MOUSEKEY_MOVE_DELTA 5 * MOUSEKEY_MAX_SPEED 8 = 40 counts per 16ms report.
#define ZMK_POINTING_DEFAULT_MOVE_VAL 2500

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/mouse.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

// Layer numbers follow the order of the layers in the keymap below, and a
// higher layer wins. The base layer modes (DVORAK, GAME) come right after BASE,
// as in the QMK keymap, so the layer-tap layers and BOARD work in every mode.
#define BASE 0
#define DVORAK 1
#define GAME 2
#define NUM 3
#define NAV 4
#define FUN 5
#define MOUSE 6
#define BOARD 7

&mt {
  flavor = "tap-preferred";
  tapping_term_ms = <150>;
  quick-tap-ms = <100>;
};

&lt {
  flavor = "tap-preferred";
  tapping_term_ms = <150>;
  quick-tap-ms = <100>;
};

&caps_word {
  // MINUS: qwerty underscore. SEMI COMMA DOT FSLH SQT: the qwerty keycodes of
  // s w v z and - when the OS is set to dvorak, so those letters and the
  // underscore are shifted too. Shift-list keys also continue caps word.
  shift-list = <MINUS SEMI COMMA DOT FSLH SQT>;
  continue-list = <UNDERSCORE BACKSPACE DELETE>;
};

&mmv {
    x-input-code = <INPUT_REL_X>;
    y-input-code = <INPUT_REL_Y>;
    time-to-max-speed-ms = <720>; // QMK MOUSEKEY_TIME_TO_MAX: 45 reports * 16ms
    acceleration-exponent = <1>;
};


/ {
  behaviors {
    // Home row mod timings match the QMK keymap: tapping terms of 125ms
    // (shift), 165ms (alt/ctrl) and 200ms (gui) and quick-tap = tapping term.

    // Holding both shift modtaps turns on caps word, like QMK's
    // BOTH_SHIFTS_TURNS_ON_CAPS_WORD: each side's hold is a shift that morphs
    // into caps word while the other side's shift is held. The hold param
    // (LSHFT/RSHFT) is ignored and only documents which shift is sent.
    lsft_cw: lsft_cw {
      compatible = "zmk,behavior-mod-morph";
      #binding-cells = <0>;
      bindings = <&kp LSHFT>, <&caps_word>;
      mods = <(MOD_RSFT)>;
    };

    rsft_cw: rsft_cw {
      compatible = "zmk,behavior-mod-morph";
      #binding-cells = <0>;
      bindings = <&kp RSHFT>, <&caps_word>;
      mods = <(MOD_LSFT)>;
    };

    mt_lsft: mt_lsft {
      compatible = "zmk,behavior-hold-tap";
      label = "left shift modtap";
      #binding-cells = <2>;
      tapping_term_ms = <125>;
      quick-tap-ms = <125>;
      flavor = "tap-preferred";
      bindings = <&lsft_cw>, <&kp>;
    };

    mt_rsft: mt_rsft {
      compatible = "zmk,behavior-hold-tap";
      label = "right shift modtap";
      #binding-cells = <2>;
      tapping_term_ms = <125>;
      quick-tap-ms = <125>;
      flavor = "tap-preferred";
      bindings = <&rsft_cw>, <&kp>;
    };

    mt_gui: mt_gui {
      compatible = "zmk,behavior-hold-tap";
      label = "gui modtap";
      #binding-cells = <2>;
      tapping_term_ms = <200>;
      quick-tap-ms = <200>;
      flavor = "tap-preferred";
      bindings = <&kp>, <&kp>;
    };

    mt_actl: mt_actl {
      compatible = "zmk,behavior-hold-tap";
      label = "alt/ctrl modtap";
      #binding-cells = <2>;
      tapping_term_ms = <165>;
      quick-tap-ms = <165>;
      flavor = "tap-preferred";
      bindings = <&kp>, <&kp>;
    };

    // Like &lt, but tapping then holding again within quick-tap-ms holds
    // backspace (as lt_spc does for space) instead of activating the layer
    lt_bspc: lt_bspc {
      compatible = "zmk,behavior-hold-tap";
      label = "backspace layer-tap";
      #binding-cells = <2>;
      tapping_term_ms = <150>;
      quick-tap-ms = <150>;
      flavor = "tap-preferred";
      bindings = <&mo>, <&kp>;
    };

    lt_spc: lt_spc {
      compatible = "zmk,behavior-hold-tap";
      label = "space modtap";
      #binding-cells = <2>;
      tapping_term_ms = <175>;
      quick-tap-ms = <150>;
      require-prior-idle-ms = <150>;
      flavor = "tap-preferred";
      bindings = <&mo>, <&kp>;
    };

    // Scroll keys send one wheel step as soon as they're pressed, like QMK, and
    // keep scrolling while held. &msc alone needs ~100ms of hold for its first
    // step, so a quick tap did nothing. msc_step runs for exactly one 32ms tick
    // at 32 steps/s (one step), then &msc takes over until release.
    msc_step: msc_step {
      compatible = "zmk,behavior-input-two-axis";
      #binding-cells = <1>;
      x-input-code = <INPUT_REL_HWHEEL>;
      y-input-code = <INPUT_REL_WHEEL>;
      trigger-period-ms = <32>;
      time-to-max-speed-ms = <0>;
      acceleration-exponent = <0>;
    };

#define SCROLL_MACRO(name, step, hold)                                         \
    name: name {                                                               \
      compatible = "zmk,behavior-macro";                                       \
      #binding-cells = <0>;                                                    \
      wait-ms = <0>;                                                           \
      tap-ms = <0>;                                                            \
      /* &macro_wait_time sets the wait after each following binding */         \
      bindings = <&macro_wait_time 48>, <&macro_press &msc_step step>,         \
                 <&macro_wait_time 0>, <&macro_release &msc_step step>,        \
                 <&macro_press &msc hold>, <&macro_pause_for_release>,         \
                 <&macro_release &msc hold>;                                   \
    };

    SCROLL_MACRO(scrl_up, MOVE_Y(32), SCRL_UP)
    SCROLL_MACRO(scrl_down, MOVE_Y(-32), SCRL_DOWN)
    SCROLL_MACRO(scrl_left, MOVE_X(-32), SCRL_LEFT)
    SCROLL_MACRO(scrl_right, MOVE_X(32), SCRL_RIGHT)
  };

  msc_step_listener: msc_step_listener {
    compatible = "zmk,input-listener";
    device = <&msc_step>;
  };

  // Layout: the corne 3x6+3 layout sits on rows 1-3 and the three inner thumb
  // keys of each half. The Link adds a number row, an encoder push button on
  // each half (row 3, middle) and two outer thumb keys per half.
  keymap {
    compatible = "zmk,keymap";

    BASE_LAYER {
        display-name = "BASE";
        bindings = <
    &kp GRAVE  &kp N1          &kp N2           &kp N3           &kp N4           &kp N5                       &kp N6   &kp N7           &kp N8           &kp N9          &kp N0             &kp EQUAL
    &kp ESC    &mt_actl LALT Q &mt_gui  LGUI W  &mt_actl LCTRL E &mt_lsft LSHFT R &kp T                        &kp Y    &mt_rsft RSHFT U &mt_actl RCTRL I &mt_gui  RGUI O &mt_actl LALT P    &kp LBKT
    &caps_word &mt_gui  LGUI A &mt_actl LALT S  &mt_lsft LSHFT D &mt_actl LCTRL F &kp G                        &kp H    &mt_actl RCTRL J &mt_rsft RSHFT K &mt_actl LALT L &mt_gui  RGUI SEMI &kp SQT
    &kp LSHFT  &kp Z           &kp X            &kp C            &kp V            &kp B &kp C_MUTE  &kp C_PP   &kp N    &kp M            &kp COMMA        &kp DOT         &kp FSLH           &kp RSHFT
               &kp LGUI        &kp LALT         &lt BOARD TAB    &lt FUN ESC      &lt_bspc NUM BSPC &lt_spc MOUSE SPACE &lt NAV ENTER    &lt BOARD DEL    &kp RALT        &kp RGUI
        >;

        sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp PG_DN PG_UP>;
    };
    // dvorak
    DVORAK_LAYER {
        display-name = "DVORAK";
        bindings = <
    &trans     &trans            &trans              &trans             &trans           &trans                 &trans &trans           &trans           &trans          &trans          &trans
    &kp ESC    &mt_actl LALT SQT &mt_gui  LGUI COMMA &mt_actl LCTRL DOT &mt_lsft LSHFT P &kp Y                  &kp F  &mt_rsft RSHFT G &mt_actl RCTRL C &mt_gui  RGUI R &mt_actl LALT L &kp FSLH
    &caps_word &mt_gui  LGUI A   &mt_actl LALT O     &mt_lsft LSHFT E   &mt_actl LCTRL U &kp I                  &kp D  &mt_actl RCTRL H &mt_rsft RSHFT T &mt_actl LALT N &mt_gui  RGUI S &kp MINUS
    &kp LSHFT  &kp SEMI          &kp Q               &kp J              &kp K            &kp X &trans    &trans &kp B  &kp M            &kp W            &kp V           &kp Z           &kp RSHFT
                                 &trans              &trans             &trans           &trans &trans   &trans &trans &trans           &trans           &trans
        >;
    };
    // gaming
    GAME_LAYER {
        display-name = "GAME";
        bindings = <
    &kp ESC   &trans &trans &trans &trans &trans                      &trans &trans &trans    &trans  &trans   &trans
    &kp TAB   &kp Q  &kp W  &kp E  &kp R  &kp T                       &kp Y  &kp U  &kp I     &kp O   &kp P    &kp LBKT
    &kp LSHFT &kp A  &kp S  &kp D  &kp F  &kp G                       &kp H  &kp J  &kp K     &kp L   &kp SEMI &kp SQT
    &kp LCTRL &kp Z  &kp X  &kp C  &kp V  &kp B  &trans        &trans              &kp N  &kp M  &kp COMMA &kp DOT &kp FSLH &kp RSHFT
                     &trans &trans &trans &trans &lt NUM SPACE &lt_spc MOUSE SPACE &trans &trans &trans &trans
        >;
    };
    // num/sym
    NUM_LAYER {
        display-name = "NUM";
        bindings = <
    &trans    &trans             &trans           &trans              &trans              &trans                    &trans    &trans              &trans               &trans             &trans             &trans
    &kp GRAVE &mt_actl LALT EXCL &mt_gui  LGUI AT &mt_actl LCTRL HASH &mt_lsft LSHFT DLLR &kp PRCNT                 &kp CARET &mt_rsft RSHFT AMPS &mt_actl RCTRL ASTRK &mt_gui  RGUI LPAR &mt_actl LALT RPAR &kp EQUAL
    &kp TILDE &mt_gui  LGUI N1   &mt_actl LALT N2 &mt_lsft LSHFT N3   &mt_actl LCTRL N4   &kp N5                    &kp N6    &mt_actl RCTRL N7   &mt_rsft RSHFT N8    &mt_actl LALT N9   &mt_gui  RGUI N0   &kp MINUS
    &trans    &kp GRAVE          &kp TILDE        &kp E               &kp UNDER           &kp PLUS  &trans   &trans &kp LS(Z) &kp RBKT            &kp RBRC             &kp PIPE           &kp BSLH           &trans
                                 &trans           &trans              &trans              &trans    &trans   &trans &trans    &trans              &trans               &trans
        >;
    };
    // nav
    NAV_LAYER {
        display-name = "NAV";
        bindings = <
    &trans &trans     &trans     &trans       &trans       &trans                    &trans      &trans          &trans      &trans      &trans    &trans
    &trans &trans     &trans     &trans       &kp K_PP     &trans                    &kp PG_UP   &kp HOME        &kp UP      &kp END     &kp PSCRN &kp F12
    &trans &trans     &trans     &trans       &trans       &trans                    &kp PG_DN   &kp LEFT        &kp DOWN    &kp UP      &kp RIGHT &kp ENTER
    &trans &kp K_PREV &kp K_NEXT &kp K_VOL_DN &kp K_VOL_UP &kp K_PP &trans    &trans &kp LC(TAB) &kp LC(LS(TAB)) &kp LC(TAB) &kp LS(INS) &trans    &trans
                      &trans     &trans       &trans       &trans   &trans    &trans &trans      &trans          &trans      &trans
        >;
    };
    // fun
    FUN_LAYER {
        display-name = "FUN";
        bindings = <
    &trans &trans &trans &trans &trans &trans                &trans          &trans &trans &trans &trans  &trans
    &trans &kp F1 &kp F2 &kp F3 &kp F4 &kp F5                &kp F6          &kp F7 &kp F8 &kp F9 &kp F10 &kp F11
    &trans &trans &trans &trans &trans &trans                &kp PSCRN       &trans &trans &trans &trans  &kp F12
    &trans &trans &trans &trans &trans &trans &trans  &trans &kp PAUSE_BREAK &trans &trans &trans &trans  &trans
                  &trans &trans &trans &trans &trans  &trans &trans          &trans &trans &trans
        >;
    };
    // mouse
    MOUSE_LAYER {
        display-name = "MOUSE";
        bindings = <
    &trans &trans &trans   &trans   &trans   &trans                &trans         &trans         &trans          &trans       &trans          &trans
    &trans &trans &mkp MB1 &mkp MB3 &mkp MB2 &trans                &scrl_up       &mkp MB1       &mkp MB3        &mkp MB2     &trans          &trans
    &trans &trans &trans   &trans   &trans   &trans                &scrl_down     &mmv MOVE_LEFT &mmv MOVE_DOWN  &mmv MOVE_UP &mmv MOVE_RIGHT &trans
    &trans &trans &trans   &trans   &trans   &trans &trans  &trans &trans         &scrl_left     &scrl_right     &kp  LS(INS) &trans          &trans
                  &trans   &trans   &trans   &trans &trans  &trans &trans         &trans         &trans          &trans
        >;
    };
    // keyboard
    BOARD_LAYER {
        display-name = "BOARD";
        bindings = <
    &trans      &trans       &trans       &trans       &trans       &trans                              &trans       &trans &trans &trans &trans &trans
    &bootloader &to BASE     &to DVORAK   &to GAME     &trans       &trans                              &trans       &trans &trans &trans &trans &bootloader
    &bt BT_CLR  &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4                        &out OUT_TOG &trans &trans &trans &trans &trans
    &trans      &trans       &trans       &trans       &trans       &trans       &trans  &trans         &trans       &trans &trans &trans &trans &trans
                             &trans       &trans       &trans       &tog FUN     &tog NUM  &tog MOUSE   &tog NAV     &trans &trans &trans
        >;
    };
  };
};
